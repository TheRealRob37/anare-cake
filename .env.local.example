# ─── Supabase ─────────────────────────────────────────────────────────────────
# Create a project at https://supabase.com and find these in:
# Project Settings → API

# Public URL (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon/public key (safe to expose — RLS protects your data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key (SECRET — server-side only, never expose to browser)
# Used by API routes to bypass RLS for admin operations
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Staff dashboard security ────────────────────────────────────────────────
# Password staff enter at /staff/login
STAFF_PASSWORD=your_strong_password_here
# Random cookie token — generate with: openssl rand -hex 32
STAFF_SESSION_TOKEN=replace_with_random_64_char_hex

# ─── Yandex Maps ──────────────────────────────────────────────────────────────
# Get yours at: https://developer.tech.yandex.ru/
# Without this key the map is hidden and a manual text input is shown instead.
NEXT_PUBLIC_YANDEX_MAPS_KEY=your_yandex_maps_api_key_here

# ─── Payment gateway ──────────────────────────────────────────────────────────
# Option A — Stripe (Visa, Mastercard, Google Pay, Apple Pay)
# https://dashboard.stripe.com/apikeys
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_SECRET_KEY=sk_live_...
#
# Option B — IDBank / Ameriabank (adds ARCA support for Armenian cards)
# PAYMENT_GATEWAY_KEY=...
# PAYMENT_GATEWAY_SECRET=...
