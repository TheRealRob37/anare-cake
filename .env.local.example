# Yandex Maps API key
# Get yours at: https://developer.tech.yandex.ru/
# Required for the interactive delivery address map on the checkout page.
# Without this key the map is hidden and a manual text input is shown instead.
NEXT_PUBLIC_YANDEX_MAPS_KEY=your_yandex_maps_api_key_here

# Payment gateway (choose one and add its keys below)
#
# Option A — Stripe (Visa, Mastercard, Google Pay, Apple Pay)
# https://dashboard.stripe.com/apikeys
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_SECRET_KEY=sk_live_...
#
# Option B — IDBank / Ameriabank (adds ARCA support for Armenian cards)
# Contact your bank for API credentials.
# PAYMENT_GATEWAY_KEY=...
# PAYMENT_GATEWAY_SECRET=...
